PORT=8080
HOST=0.0.0.0

# PostgreSQL (native install)
DATABASE_URL=postgres://realmshaper:realmshaper@127.0.0.1:5432/realmshaper

# RustFS (S3-compatible, native install)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=realmshaper-pgc
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SEC=300

AUTOSAVE_INTERVAL_MS=30000

